// Starter models — replace with your own

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  
  name      String
  lastName  String 

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
  @@map("users")
}

model Product {
  id          String   @id @default(cuid())
  title       String
  description String?
  price       Float
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sellerId    String
  seller      User     @relation(fields: [sellerId], references: [id])
}
