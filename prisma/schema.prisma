// DROPX Store — single-store sneaker catalog.
// Domain mirrors src/types/product.ts:
//   Brand → Product → ProductVariant (colorway) → VariantSize (per-size stock)
// plus user Cart / Wishlist. Auth tables are managed by the NextAuth PrismaAdapter.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum ProductCategory {
  running
  basketball
  lifestyle
  skateboarding
}

enum ProductGender {
  men
  women
  unisex
}

// Mirrors BadgeVariant in src/components/ui/Badge.tsx.
// `soldOut` is usually derived from stock, but kept here so a product can be
// force-flagged (e.g. an ended drop) without touching inventory.
enum ProductBadge {
  new
  limited
  discount
  soldOut
}

enum OrderStatus {
  processing
  shipped
  delivered
}

enum PaymentMethod {
  blik
  card
  przelewy24
  apple_pay
  google_pay
}

// ---------------------------------------------------------------------------
// Auth (NextAuth) + User
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id       String @id @default(cuid())
  email    String @unique
  password String

  name     String
  lastName String

  phone      String?
  address    String?
  city       String?
  postalCode String? @map("postal_code")
  country    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  sessions Session[]
  cart     Cart?
  wishlist WishlistItem[]
  orders   Order[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Brand {
  id       String  @id @default(cuid())
  name     String  @unique
  slug     String  @unique
  logoUrl  String?

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("brands")
}

model Product {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String
  description String?
  category    ProductCategory
  gender      ProductGender   @default(unisex)

  brandId String @map("brand_id")
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  // Product-level presentation (applies to the whole model, not a colorway).
  badge         ProductBadge?
  discountValue Int? // percentage, e.g. 20 → "-20%"
  currency      String        @default("EUR")
  featured      Boolean       @default(false) // "Featured Picks" collection

  /** When set in the future, product is visible but not purchasable until then. */
  availableAt DateTime? @map("available_at")
  /** Optional PDP / campaign hero (placeholder until real assets land). */
  heroImageUrl String? @map("hero_image_url")

  variants ProductVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId])
  @@index([category])
  @@index([gender])
  @@index([availableAt])
  @@map("products")
}

model ProductVariant {
  id          String @id @default(cuid())
  color       String // e.g. "Triple White"
  colorHex    String // e.g. "#F5F5F5" — swatch dot
  colorFamily String @default("multi") // normalized filter bucket — e.g. "white", "black", "red"
  imageUrl    String?
  price       Float

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sizes         VariantSize[]
  wishlistItems WishlistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@map("product_variants")
}

model VariantSize {
  id    String @id @default(cuid())
  size  String // EU sizing — e.g. "EU 42"
  stock Int    @default(0)

  variantId String         @map("variant_id")
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([variantId, size])
  @@map("variant_sizes")
}

// ---------------------------------------------------------------------------
// Cart & Wishlist
// ---------------------------------------------------------------------------

model Cart {
  id     String @id @default(cuid())
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("carts")
}

model CartItem {
  id       String @id @default(cuid())
  quantity Int    @default(1)

  cartId String @map("cart_id")
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  // A cart line references a specific size (which also carries current stock).
  sizeId String      @map("size_id")
  size   VariantSize @relation(fields: [sizeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, sizeId])
  @@map("cart_items")
}

model WishlistItem {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  variantId String         @map("variant_id")
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, variantId])
  @@map("wishlist_items")
}

// ---------------------------------------------------------------------------
// Orders
// Line items snapshot product details at purchase time so history stays intact
// even if the catalog changes later.
// ---------------------------------------------------------------------------

model Order {
  id            String        @id @default(cuid())
  number        String        @unique // e.g. "DX-78234"
  status        OrderStatus   @default(processing)
  paymentMethod PaymentMethod @map("payment_method")

  currency String @default("EUR")
  subtotal Float
  shipping Float
  discount Float  @default(0)
  promoCode String? @map("promo_code")
  total    Float

  // Contact + shipping snapshot at checkout
  email         String
  phone         String?
  firstName     String @map("first_name")
  lastName      String @map("last_name")
  address       String
  city          String
  postalCode    String @map("postal_code")
  country       String
  shippingMethod String @map("shipping_method") // "standard" | "express"

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@map("orders")
}

model OrderItem {
  id       String @id @default(cuid())
  quantity Int
  unitPrice Float @map("unit_price")

  // Display snapshots
  productName String  @map("product_name")
  brandName   String  @map("brand_name")
  color       String
  size        String
  imageUrl    String? @map("image_url")

  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Optional live ref — kept for inventory / admin; nullable if size is removed.
  sizeId String?      @map("size_id")
  sizeRef VariantSize? @relation(fields: [sizeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@map("order_items")
}

// ---------------------------------------------------------------------------
// Newsletter
// Guests can subscribe; unique email. MEMBER10 unlocks when a user signs in
// with a subscribed email.
// ---------------------------------------------------------------------------

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("newsletter_subscribers")
}
