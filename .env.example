# Copy to `.env` and fill in real values. Never commit `.env`.

# ---------------------------------------------------------------------------
# Database (Supabase Postgres — Prisma connects via DATABASE_URL only)
# ---------------------------------------------------------------------------
# Use the Session pooler URL from Supabase → Project Settings → Database.
# Example shape (replace ref / password / region):
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# ---------------------------------------------------------------------------
# Auth (NextAuth v5 / Auth.js)
# ---------------------------------------------------------------------------
# Generate locally: `openssl rand -base64 32`
AUTH_SECRET="replace-with-a-long-random-string"

# Public site URL. Local default is fine; on Vercel set to your deployment URL.
AUTH_URL="http://localhost:3000"

# Recommended on Vercel so Auth.js trusts the host header behind the proxy.
AUTH_TRUST_HOST="true"

# Optional fallback name (same value as AUTH_SECRET if you already use it)
# BETTER_AUTH_SECRET=""

# ---------------------------------------------------------------------------
# Images (Cloudinary — delivery only; cloud name is enough)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"

# ---------------------------------------------------------------------------
# Not wired yet (OAuth buttons are UI-only)
# ---------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
